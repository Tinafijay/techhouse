<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>GoFundC</title>
  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    }
    body {
      background-color: #f8f9fa;
      color: #212529;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      min-height: 100vh;
      padding: 16px;
    }
    .card {
      background: #ffffff;
      border: 1px solid #e9ecef;
      border-radius: 16px;
      max-width: 420px;
      width: 100%;
      padding: 20px;
      box-shadow: 0 10px 25px rgba(0, 0, 0, 0.05);
      text-align: center;
    }
    .brand {
      font-size: 24px;
      font-weight: 800;
      color: #0d6efd;
      margin-bottom: 16px;
      letter-spacing: -0.5px;
    }
    
    /* Carousel Styling */
    .carousel-container {
      position: relative;
      width: 100%;
      border-radius: 12px;
      overflow: hidden;
      background-color: #000;
      margin-bottom: 20px;
    }
    .carousel-slide {
      display: flex;
      width: 100%;
      transition: transform 0.4s ease-in-out;
    }
    .slide-item {
      min-width: 100%;
      box-sizing: border-box;
      position: relative;
      display: flex;
      flex-direction: column;
      align-items: center;
    }
    .slide-item img {
      width: 100%;
      height: 340px;
      object-fit: cover;
      display: block;
    }
    .slide-caption {
      background: rgba(0, 0, 0, 0.75);
      color: #ffffff;
      width: 100%;
      padding: 12px 14px;
      font-size: 14px;
      font-weight: 500;
      line-height: 1.4;
      text-align: center;
    }
    .carousel-btn {
      position: absolute;
      top: 40%;
      transform: translateY(-50%);
      background: rgba(0, 0, 0, 0.5);
      color: white;
      border: none;
      width: 36px;
      height: 36px;
      border-radius: 50%;
      cursor: pointer;
      font-weight: bold;
      font-size: 16px;
      display: flex;
      align-items: center;
      justify-content: center;
      z-index: 10;
    }
    .prev-btn { left: 10px; }
    .next-btn { right: 10px; }

    /* Static Content Below Slides */
    .main-message {
      font-size: 16px;
      font-weight: 600;
      color: #343a40;
      line-height: 1.5;
      margin-bottom: 20px;
      background-color: #f1f3f5;
      padding: 14px;
      border-radius: 12px;
    }
    .details-box {
      border: 1px dashed #ced4da;
      border-radius: 12px;
      padding: 16px;
      margin-bottom: 16px;
      text-align: left;
    }
    .bank-title {
      font-size: 11px;
      text-transform: uppercase;
      letter-spacing: 0.8px;
      color: #6c757d;
      font-weight: 700;
      margin-bottom: 6px;
    }
    .account-name {
      font-size: 16px;
      font-weight: 700;
      color: #212529;
      margin-bottom: 2px;
    }
    .bank-name {
      font-size: 14px;
      color: #495057;
      margin-bottom: 12px;
    }
    .account-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      background-color: #f8f9fa;
      border: 1px solid #dee2e6;
      border-radius: 8px;
      padding: 8px 12px;
    }
    .account-number {
      font-family: monospace;
      font-size: 20px;
      font-weight: 800;
      color: #111827;
      letter-spacing: 1px;
    }
    .copy-btn {
      background-color: #0d6efd;
      color: #ffffff;
      border: none;
      padding: 10px 16px;
      font-size: 14px;
      font-weight: 700;
      border-radius: 8px;
      cursor: pointer;
    }
    .copy-btn.copied {
      background-color: #198754;
    }
    .footer {
      margin-top: 16px;
      font-size: 13px;
      color: #6c757d;
    }
    .footer a {
      color: #0d6efd;
      text-decoration: none;
      font-weight: 600;
    }
  </style>
</head>
<body>

  <div class="card">
    <div class="brand">GoFundC</div>
    
    <!-- Slideshow -->
    <div class="carousel-container">
      <div class="carousel-slide" id="slider">
        
        <!-- Slide 1 -->
        <div class="slide-item">
          <img src="Gofundme image1.jpeg" alt="Welcome Image">
          <div class="slide-caption">
            Welcome to my GoFundC page!
          </div>
        </div>

        <!-- Slide 2 -->
        <div class="slide-item">
          <img src="go fundme image2.jpeg" alt="Baby Picture">
          <div class="slide-caption">
            This is who y'all don't want to break free from the shackles of iPhone 11 🥺
          </div>
        </div>

        <!-- Slide 3 -->
        <div class="slide-item">
          <img src="go fund me Go fund me image3.jpeg" alt="Red Hair Selfie">
          <div class="slide-caption">
            Good day Reader, I hope you’re doing well. Please, I really need help to get a new phone. Thank you all for supporting! ❤️
          </div>
        </div>

      </div>

      <button class="carousel-btn prev-btn" onclick="moveSlide(-1)">&#10094;</button>
      <button class="carousel-btn next-btn" onclick="moveSlide(1)">&#10095;</button>
    </div>

    <!-- Main Message -->
    <div class="main-message">
      I dey use iPhone 11 for 2026💔 help a girl out
    </div>

    <!-- Bank Details Section -->
    <div class="details-box">
      <div class="bank-title">Account Details</div>
      <div class="account-name">Chundung Daniella Buba</div>
      <div class="bank-name">Moniepoint</div>
      
      <div class="account-row">
        <span class="account-number" id="accNum">9041482162</span>
        <button class="copy-btn" id="copyBtn" onclick="copyNumber()">Copy</button>
      </div>
    </div>
  </div>

  <div class="footer">
    Powered by <a href="https://wa.me/2348057813535?text=Hi%20Tech%20House,%20I%20want%20to%20build%20a%20website." target="_blank">Tech House Web Services</a>
  </div>

  <script>
    // Copy Account Number Logic
    function copyNumber() {
      const num = document.getElementById("accNum").innerText.trim();
      navigator.clipboard.writeText(num).then(() => {
        const btn = document.getElementById("copyBtn");
        btn.innerText = "Copied!";
        btn.classList.add("copied");
        setTimeout(() => {
          btn.innerText = "Copy";
          btn.classList.remove("copied");
        }, 2000);
      });
    }

    // Carousel Navigation Logic
    let currentIndex = 0;
    function moveSlide(direction) {
      const slider = document.getElementById("slider");
      const totalSlides = slider.children.length;
      currentIndex = (currentIndex + direction + totalSlides) % totalSlides;
      slider.style.transform = `translateX(-${currentIndex * 100}%)`;
    }
  </script>

</body>
</html>  
